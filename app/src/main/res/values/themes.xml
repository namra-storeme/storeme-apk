<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material You Light Theme - Google Drive / Files style (no custom font) -->
    <style name="Theme.StoreMeNative" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/md3_bg</item>
        <item name="android:statusBarColor">@color/md3_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/md3_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorPrimary">@color/md3_primary</item>
        <item name="colorPrimaryVariant">@color/md3_primary</item>
        <item name="colorAccent">@color/md3_primary</item>
        <item name="colorSurface">@color/md3_surface</item>
        <item name="colorOnSurface">@color/md3_text_primary</item>
        <item name="colorError">@color/md3_error</item>
        <item name="colorControlHighlight">#1A1A73E8</item>
        <item name="colorControlNormal">@color/md3_text_secondary</item>
        <item name="android:textColorPrimary">@color/md3_text_primary</item>
        <item name="android:textColorSecondary">@color/md3_text_secondary</item>
    </style>

    <style name="Theme.StoreMeNative.DarkAuth" parent="Theme.StoreMeNative"/>
</resources>
