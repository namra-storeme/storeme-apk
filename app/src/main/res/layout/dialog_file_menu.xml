<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_md3_bottom_sheet"
        android:orientation="vertical"
        android:padding="12dp">

    <!-- Handle -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_md3_nav_bar"
        android:backgroundTint="@color/md3_outline"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/textMenuTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="File.txt"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/md3_text_primary"
        android:maxLines="1"
        android:ellipsize="middle"
        android:layout_marginBottom="12dp"/>

    <!-- Actions -->
    <LinearLayout
        android:id="@+id/btnMenuDownload"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_download_round"
        android:tint="@color/md3_text_secondary"/>
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Download"
        android:layout_marginStart="16dp"
        android:textSize="11sp"
        android:textColor="@color/md3_text_primary"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnMenuShare"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_link"
        android:tint="@color/md3_text_secondary"/>
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Share Link"
        android:layout_marginStart="16dp"
        android:textSize="11sp"
        android:textColor="@color/md3_text_primary"/>
    </LinearLayout>
    
    <LinearLayout
        android:id="@+id/btnMenuZip"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_archive"
        android:tint="@color/md3_text_secondary"/>
        <TextView
        android:id="@+id/textMenuZip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Compress"
        android:layout_marginStart="16dp"
        android:textSize="11sp"
        android:textColor="@color/md3_text_primary"/>
    </LinearLayout>
    
    <LinearLayout
        android:id="@+id/btnMenuDetails"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_info"
        android:tint="@color/md3_text_secondary"/>
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Details"
        android:layout_marginStart="16dp"
        android:textSize="11sp"
        android:textColor="@color/md3_text_primary"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md3_outline"
        android:layout_marginVertical="8dp"/>

    <!-- Move -->
    <LinearLayout
        android:id="@+id/btnMenuMove"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_folder"
        android:tint="@color/md3_primary"/>
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Move File"
        android:layout_marginStart="16dp"
        android:textSize="11sp"
        android:textColor="@color/md3_primary"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnMenuRestore"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_archive"
        android:tint="@color/md3_success"/>
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Restore File"
        android:layout_marginStart="16dp"
        android:textSize="11sp"
        android:textColor="@color/md3_success"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnMenuTrash"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_delete"
        android:tint="@color/md3_error"/>
        <TextView
        android:id="@+id/textMenuTrash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delete"
        android:layout_marginStart="16dp"
        android:textSize="11sp"
        android:textColor="@color/md3_error"/>
    </LinearLayout>
</LinearLayout>
