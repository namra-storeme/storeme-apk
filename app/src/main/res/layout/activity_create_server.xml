<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/md3_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">
        <ImageView
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_back"
        android:tint="@color/md3_text_primary"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"/>
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Host Setup"
        android:textColor="@color/md3_text_primary"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="16dp"/>
        
</LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Initialize a new server"
        android:textSize="11sp"
        android:textColor="@color/md3_text_primary"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="12dp"/>

            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Host ID"
        android:textColor="@color/md3_text_secondary"
        android:textSize="11sp"
        android:layout_marginBottom="8dp"/>
            <EditText
        android:id="@+id/editHostId"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_md3_input"
        android:paddingHorizontal="12dp"
        android:textColor="@color/md3_text_primary"
        android:textColorHint="@color/md3_text_secondary"
        android:hint="Enter a unique Host ID"
        android:layout_marginBottom="12dp"/>

            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password"
        android:textColor="@color/md3_text_secondary"
        android:textSize="11sp"
        android:layout_marginBottom="8dp"/>
            <EditText
        android:id="@+id/editPassword"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_md3_input"
        android:paddingHorizontal="12dp"
        android:textColor="@color/md3_text_primary"
        android:textColorHint="@color/md3_text_secondary"
        android:hint="Enter password"
        android:inputType="textPassword"/>

            <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:visibility="gone"/>

            <Button
        android:background="@drawable/bg_md3_button"
        android:textColor="#000000"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:id="@+id/btnCreate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="Initialize Server"
        android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
