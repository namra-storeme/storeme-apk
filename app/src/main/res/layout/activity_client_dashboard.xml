<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md3_bg">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@color/md3_surface"
        android:elevation="0dp"
        android:layout_alignParentTop="true">

        <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal">
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Store"
        android:textColor="@color/md3_text_primary"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"/>
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Me"
        android:textColor="@color/md3_primary"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Client Node"
        android:textColor="@color/md3_text_on_primary"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_md3_chip"
        android:backgroundTint="@color/md3_success"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@+id/bottomNavInclude">
        
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

            <!-- Storage Card -->
            <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_md3_surface"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="12dp">
                
                <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
                    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_storage"
        android:tint="@color/md3_primary"
        android:layout_marginEnd="12dp"/>
                    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
                        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Host Storage"
        android:textColor="@color/md3_text_secondary"
        android:textSize="11sp"/>
                        <TextView
        android:id="@+id/textClientStorage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loading..."
        android:textColor="@color/md3_text_primary"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Custom Bar Chart Mockup using Linear Layout -->
                <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:clipToOutline="true"
        android:background="@drawable/bg_md3_surface_variant">
                    
                    <View
        android:id="@+id/barImages"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0"
        android:background="@color/md3_primary"/>
                    <View
        android:id="@+id/barVideos"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0"
        android:background="@color/md3_secondary"/>
                    <View
        android:id="@+id/barDocs"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0"
        android:background="@color/md3_success"/>
                    <View
        android:id="@+id/barOther"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0"
        android:background="@color/md3_warning"/>
                    <View
        android:id="@+id/barFree"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/md3_surface_variant"/>
                </LinearLayout>

                <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
                    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
                        <TextView
        android:id="@+id/legendImages"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Images"
        android:textColor="@color/md3_primary"
        android:textSize="11sp"
        android:layout_marginBottom="4dp"/>
                        <TextView
        android:id="@+id/legendVideos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Videos"
        android:textColor="@color/md3_secondary"
        android:textSize="11sp"
        android:layout_marginBottom="4dp"/>
                        <TextView
        android:id="@+id/legendDocs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Documents"
        android:textColor="@color/md3_success"
        android:textSize="11sp"/>
                    </LinearLayout>
                    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
                        <TextView
        android:id="@+id/legendOther"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Other"
        android:textColor="@color/md3_warning"
        android:textSize="11sp"
        android:layout_marginBottom="4dp"/>
                        <TextView
        android:id="@+id/legendFree"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Free Space"
        android:textColor="@color/md3_text_secondary"
        android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Network Speed Card -->
            <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_md3_surface"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
                
                <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_md3_icon_container"
        android:layout_marginEnd="16dp">
                    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_download_round"
        android:layout_gravity="center"
        android:tint="@color/md3_primary"/>
                </FrameLayout>

                <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
                    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="P2P Transfer Rate"
        android:textColor="@color/md3_text_secondary"
        android:textSize="11sp"/>
                    <TextView
        android:id="@+id/textClientSpeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 KB/s"
        android:textColor="@color/md3_text_primary"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Nav -->
    <include
        android:id="@+id/bottomNavInclude" layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>
