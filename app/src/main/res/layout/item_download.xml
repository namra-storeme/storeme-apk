<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_md3_surface"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_md3_icon_container"
            android:layout_marginEnd="16dp">
            <ImageView
                android:id="@+id/imgActivityIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_download_round"
                android:tint="@color/md3_primary"
                android:layout_gravity="center"/>
        </FrameLayout>
            
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/textFilename"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="File.zip"
                android:textColor="@color/md3_text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="middle"/>
            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">
                <ImageView
                    android:id="@+id/imgStatusIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_download_round"
                    android:tint="@color/md3_primary"
                    android:layout_marginEnd="4dp"/>
                <TextView
                    android:id="@+id/textStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Downloading"
                    android:textColor="@color/md3_text_secondary"
                    android:textSize="12sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textColor="@color/md3_text_secondary"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/textBytes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 MB"
                    android:textColor="@color/md3_text_secondary"
                    android:textSize="12sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textColor="@color/md3_text_secondary"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/textSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.2 MB/s"
                    android:textColor="@color/md3_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/textTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Now"
            android:textColor="@color/md3_text_secondary"
            android:textSize="12sp"
            android:layout_marginEnd="8dp"/>
            
        <ImageView
            android:id="@+id/btnPauseResume"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_media_pause"
            android:tint="@color/md3_text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"/>

        <ImageView
            android:id="@+id/btnCancel"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/md3_error"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_marginStart="8dp"
            android:visibility="gone"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressDownload"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:progressTint="@color/md3_primary"
        android:backgroundTint="@color/md3_surface_variant"
        android:max="100"/>
</LinearLayout>
