<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/md3_bg">

    <!-- Top App Bar with Search -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/md3_surface"
        android:elevation="4dp"
        android:layout_alignParentTop="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">
            
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                android:tint="@color/md3_text_secondary"
                android:layout_marginEnd="12dp"/>
                
            <EditText
                android:id="@+id/editSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search files..."
                android:textColorHint="@color/md3_text_secondary"
                android:textColor="@color/md3_text_primary"
                android:textSize="16sp"
                android:maxLines="1"
                android:inputType="text"/>
        </LinearLayout>
        
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/md3_outline"/>
        
        
        
        <!-- Action bar buttons (hidden for UI but needed for Java) -->
        <View android:id="@+id/searchBar" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <View android:id="@+id/btnSearch" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <View android:id="@+id/btnGridList" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        
        <!-- Filter Chips for Java -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">
                <TextView android:id="@+id/chipAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/chipImages" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/chipVideos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/chipDocs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/chipAudio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/chipTrash" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
            </LinearLayout>
        </HorizontalScrollView>
        <!-- Breadcrumbs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:scrollbars="none"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">
                <TextView
                    android:id="@+id/textBreadcrumb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home / Documents"
                    android:textColor="@color/md3_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFiles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@+id/bottomNavInclude"
        android:clipToPadding="false"
        android:padding="8dp"/>

    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/md3_primary"/>
        <TextView
            android:id="@+id/textLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading files..."
            android:textColor="@color/md3_text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_folder"
            android:tint="@color/md3_outline"
            android:layout_marginBottom="16dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Folder is empty"
            android:textColor="@color/md3_text_secondary"
            android:textSize="16sp"/>
    </LinearLayout>

    <!-- FABs -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomNavInclude"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_clock"
            app:tint="@color/md3_primary"
            app:backgroundTint="@color/md3_surface"
            android:layout_marginBottom="16dp"
            app:fabSize="mini"
            app:elevation="4dp"/>
            
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnUpload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_upload_round"
            app:tint="@color/md3_text_on_primary"
            app:backgroundTint="@color/md3_primary"
            app:elevation="6dp"/>
    </LinearLayout>

    <!-- Move Banner -->
    <LinearLayout
        android:id="@+id/bannerMove"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md3_surface_variant"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone"
        android:gravity="center_vertical"
        android:layout_above="@id/bottomNavInclude"
        android:elevation="8dp">
        
        <TextView
            android:id="@+id/textMoveFileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Moving file..."
            android:textColor="@color/md3_text_primary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"/>
            
        <Button
            android:id="@+id/btnCancelMove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="@color/md3_error"
            android:layout_marginEnd="8dp"/>
            
        <Button
            android:id="@+id/btnMoveHere"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Move Here"
            android:textColor="@color/md3_text_on_primary"
            android:backgroundTint="@color/md3_primary"/>
    </LinearLayout>

    <include
        android:id="@+id/bottomNavInclude"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
