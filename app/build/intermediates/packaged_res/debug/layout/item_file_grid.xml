<?xml version="1.0" encoding="utf-8"?>
<!-- Grid view card: icon on top, name below, compact square -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_md3_surface"
    android:clickable="true"
    android:focusable="true"
    android:padding="12dp"
    android:gravity="center">

    <!-- Selection Checkbox -->
    <ImageView
        android:id="@+id/imgSelect"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_uncheck_circle_outline"
        android:tint="@color/md3_text_secondary"
        android:layout_gravity="start"
        android:visibility="gone"/>

    <!-- File Icon -->
    <ImageView
        android:id="@+id/imgFileIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_folder"
        android:tint="@color/icon_folder"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"/>

    <!-- File Name -->
    <TextView
        android:id="@+id/textFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="File Name"
        android:textColor="@color/md3_text_primary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="center_horizontal"/>

    <!-- Item Count / Size -->
    <TextView
        android:id="@+id/textItemCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/md3_text_tertiary"
        android:textSize="11sp"
        android:layout_marginTop="2dp"/>

    <!-- Date (hidden for grid, but available if needed) -->
    <TextView
        android:id="@+id/textFileDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="10sp"
        android:textColor="@color/md3_text_tertiary"
        android:visibility="gone"/>

    <!-- Overlay icon (unused in grid, kept for adapter compat) -->
    <ImageView
        android:id="@+id/imgOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

</LinearLayout>
