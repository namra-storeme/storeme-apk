<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_md3_dialog"
    android:padding="24dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_info"
        android:tint="@color/md3_primary"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"/>
        
    <TextView
        android:id="@+id/detailName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="File.txt"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/md3_text_primary"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Type" android:textColor="@color/md3_text_secondary" android:textSize="14sp"/>
        <TextView android:id="@+id/detailType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/md3_text_primary" android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Size" android:textColor="@color/md3_text_secondary" android:textSize="14sp"/>
        <TextView android:id="@+id/detailSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/md3_text_primary" android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Modified" android:textColor="@color/md3_text_secondary" android:textSize="14sp"/>
        <TextView android:id="@+id/detailModified" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/md3_text_primary" android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">
        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Path" android:textColor="@color/md3_text_secondary" android:textSize="14sp"/>
        <TextView android:id="@+id/detailPath" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/md3_text_primary" android:textSize="14sp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnCloseDetails"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_md3_button_primary"
        android:text="Close"
        android:textColor="@color/md3_text_on_primary"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"/>
</LinearLayout>
