<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_md3_dialog"
        android:padding="12dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_info"
        android:tint="@color/md3_primary"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp"/>
        
    <TextView
        android:id="@+id/detailName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="File.txt"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/md3_text_primary"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="Type"
        android:textColor="@color/md3_text_secondary"
        android:textSize="11sp"/>
        <TextView
        android:id="@+id/detailType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:textColor="@color/md3_text_primary"
        android:textSize="11sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="Size"
        android:textColor="@color/md3_text_secondary"
        android:textSize="11sp"/>
        <TextView
        android:id="@+id/detailSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:textColor="@color/md3_text_primary"
        android:textSize="11sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="Modified"
        android:textColor="@color/md3_text_secondary"
        android:textSize="11sp"/>
        <TextView
        android:id="@+id/detailModified"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:textColor="@color/md3_text_primary"
        android:textSize="11sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="Path"
        android:textColor="@color/md3_text_secondary"
        android:textSize="11sp"/>
        <TextView
        android:id="@+id/detailPath"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:textColor="@color/md3_text_primary"
        android:textSize="11sp"/>
    </LinearLayout>

    <Button
        android:background="@drawable/bg_md3_button"
        android:textColor="#000000"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:id="@+id/btnCloseDetails"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Close"
        android:fontFamily="sans-serif-medium"/>
</LinearLayout>
