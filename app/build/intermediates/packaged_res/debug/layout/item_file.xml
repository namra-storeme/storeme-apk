<?xml version="1.0" encoding="utf-8"?>
<!-- Google Files-style file list item: icon + name/date + size/count + 3-dot menu -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <!-- Selection Checkbox (only in selection mode) -->
        <ImageView
            android:id="@+id/imgSelect"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_uncheck_circle_outline"
            android:tint="@color/md3_text_secondary"
            android:layout_marginEnd="12dp"
            android:visibility="gone"/>

        <!-- File / Folder Icon Container -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp">
            <ImageView
                android:id="@+id/imgFileIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_folder"
                android:tint="@color/icon_folder"
                android:layout_gravity="center"/>
            <!-- Sub-type overlay (e.g. camera, download) -->
            <ImageView
                android:id="@+id/imgOverlay"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_image"
                android:visibility="gone"/>
        </FrameLayout>

        <!-- Name + Date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/textFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="File Name"
                android:textColor="@color/md3_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"/>
            <TextView
                android:id="@+id/textFileDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modified date"
                android:textColor="@color/md3_text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- Size / Item Count -->
        <TextView
            android:id="@+id/textItemCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 items"
            android:textColor="@color/md3_text_tertiary"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"/>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/divider_light"
        android:layout_marginStart="68dp"/>

</LinearLayout>
